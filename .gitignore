# routine1_shorts: 디시 실베 쇼츠 루틴 전용 파일만 올린다 (화이트리스트).
# 비밀값(config/secrets.local.json), 영상·캡처 산출물, ffmpeg/yt-dlp 실행 파일, 다른 루틴(SKILL.md, SKILL2.md, archive/)은 제외.
/*
!/.gitignore
!/README.md

!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/dcbest-shorts-producer/
!/.claude/skills/person-clip-shorts/

!/config/
/config/*
!/config/dcbest.yaml

!/schedule/

!/tools/
/tools/*
!/tools/dcbest_list.js
!/tools/dcbest_post.js
!/tools/dcbest_rank.py
!/tools/make_post_cards.py
!/tools/make_upload_info.py
!/tools/render_short.py
!/tools/tts_prepare.py
!/tools/tts_split.py
!/tools/tts_gemini.ps1
!/tools/repl_net.js
!/tools/qa_check.py
!/tools/preview_sheet.py
!/tools/giphy_fetch.ps1
!/tools/bgm_analyze.py

!/assets/
/assets/*
!/assets/fonts/
!/assets/brand/
/assets/brand/*
!/assets/brand/ending.png

__pycache__/
*.pyc
secrets*.json
